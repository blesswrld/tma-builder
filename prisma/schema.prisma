generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  password              String
  name                  String?
  plan                  String    @default("FREE") // FREE, PRO, ENTERPRISE
  subscriptionExpiresAt DateTime?
  avatarUrl             String?
  phone                 String?
  telegramHandle        String?
  companyName           String?
  isBanned              Boolean   @default(false)
  banReason             String?
  bannedAt              DateTime?
  role                  String    @default("USER") // USER, DEVELOPER
  shops                 Shop[]
  createdAt             DateTime  @default(now())
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  type      String   @default("LOGIN") // REGISTER, LOGIN, RESET_PASSWORD
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Shop {
  id                  String      @id @default(cuid())
  slug                String      @unique
  name                String
  description         String?
  logoUrl             String?
  bannerUrl           String?
  botToken            String?
  adminChatId         String?
  workingHours        String?
  address             String?
  phone               String?
  currency            String?     @default("RUB")
  currencySymbol      String?     @default("₽")
  socialLinks         String?
  deliveryOptions     String?
  paymentInstructions String?
  musicSettings       String?
  isOpen              Boolean     @default(true)
  ownerId             String?
  maxServices         Int         @default(15)
  cashbackPercent     Int         @default(5)
  owner               User?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  services            Service[]
  orders              Order[]
  promocodes          Promocode[]
  reviews             Review[]
  banners             Banner[]
  broadcasts          Broadcast[]
  customers           Customer[]
  createdAt           DateTime    @default(now())
}

model Broadcast {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title        String
  message      String
  imageUrl     String?
  buttonText   String?  @default("📱 Открыть Меню")
  targetFilter String   @default("ALL") // ALL, ACTIVE, INACTIVE
  sentCount    Int      @default(0)
  status       String   @default("SENT") // SENT, SCHEDULED, DRAFT
  createdAt    DateTime @default(now())
}

model Customer {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  phone        String
  name         String
  bonusBalance Int      @default(0)
  totalSpent   Int      @default(0)
  ordersCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Banner {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title       String
  subtitle    String?
  imageUrl    String?
  badge       String?
  bgGradient  String?  @default("from-slate-900 to-indigo-950")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Service {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title       String
  price       Int
  oldPrice    Int?
  description String?
  category    String?
  imageUrl    String?
  gallery     String?
  badge       String?
  tags        String?
  prepTime    String?
  weight      String?
  isAvailable Boolean  @default(true)
  fulfillment String?  @default("pickup")
  createdAt   DateTime @default(now())
}

model Order {
  id                String   @id @default(cuid())
  shopId            String
  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerName      String
  customerPhone     String
  tableNumber       String?
  preferredTime     String?
  items             String   // JSON string storing ordered items
  totalPrice        Int
  status            String   @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  note              String?
  fulfillmentMethod String?  @default("courier")
  deliveryAddress   String?
  createdAt         DateTime @default(now())
}

model Promocode {
  id              String    @id @default(cuid())
  shopId          String
  shop            Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  code            String
  discountPercent Int       @default(0)
  discountAmount  Int       @default(0)
  minOrderAmount  Int?      @default(0)
  expiresAt       DateTime?
  description     String?
  isActive        Boolean   @default(true)
  maxUses         Int       @default(100)
  usedCount       Int       @default(0)
  createdAt       DateTime  @default(now())
}

model Review {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerName String
  rating       Int      @default(5)
  comment      String?
  imageUrl     String?
  reply        String?
  isEdited     Boolean  @default(false)
  authorToken  String?
  createdAt    DateTime @default(now())
}

model Report {
  id             String   @id @default(cuid())
  type           String   @default("BUG")
  title          String?
  description    String
  attachments    String?
  contact        String?
  userId         String?
  shopId         String?
  metadata       String?
  status         String   @default("NEW")
  developerEmail String?
  developerNotes String?
  createdAt      DateTime @default(now())
}

model ShopMember {
  id        String   @id @default(cuid())
  shopId    String
  userId    String
  role      String   @default("STAFF")
  createdAt DateTime @default(now())
}

model ShopInvite {
  id          String    @id @default(cuid())
  shopId      String
  code        String    @unique
  role        String    @default("STAFF")
  createdById String
  maxUses     Int       @default(10)
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

model Payment {
  id              String    @id @default(cuid())
  userId          String
  plan            String    // PRO, ENTERPRISE
  amount          Int
  paymentMethod   String    // card, sbp, promo
  status          String    @default("PENDING") // PENDING, SUCCEEDED, CANCELED
  yooPaymentId    String?   @unique
  confirmationUrl String?
  qrUrl           String?
  promocode       String?
  paidAt          DateTime?
  metadata        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model SystemPromocode {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Int       @default(100)
  applicablePlan  String?   // ALL, PRO, ENTERPRISE
  maxUses         Int       @default(1000)
  usedCount       Int       @default(0)
  isActive        Boolean   @default(true)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
}

