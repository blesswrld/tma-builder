generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  password              String
  name                  String?
  plan                  String    @default("FREE") // FREE, PRO, ENTERPRISE
  subscriptionExpiresAt DateTime?
  shops                 Shop[]
  createdAt             DateTime  @default(now())
}

model Shop {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  logoUrl     String?
  botToken    String?
  adminChatId String?
  workingHours String?
  address     String?
  phone       String?
  isOpen      Boolean   @default(true)
  ownerId     String?
  maxServices Int       @default(15)
  owner       User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  services    Service[]
  orders      Order[]
  createdAt   DateTime  @default(now())
}

model Service {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title       String
  price       Int
  description String?
  category    String?
  createdAt   DateTime @default(now())
}

model Order {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String
  tableNumber   String?
  preferredTime String?
  items         String   // JSON string storing ordered items
  totalPrice    Int
  status        String   @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  note          String?
  createdAt     DateTime @default(now())
}
