# URL базы данных PostgreSQL (Для Supabase используйте порт 6543 - Transaction Mode + pgbouncer=true)
DATABASE_URL="postgresql://postgres.xxx:password@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=2"

# Настройки Telegram бота
TELEGRAM_BOT_TOKEN="Ваш_Токен_Бота"
ADMIN_CHAT_ID="Ваш_Chat_ID"

# Базовый URL приложения
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Настройки SMTP для отправки писем
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM_NAME="TMA-Builder"

JWT_SECRET="your-jwt-secret"
